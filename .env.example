NODE_ENV=production
PORT=80
DATAQ_PORT=3303
COMPOSE_FILE=docker-compose.yml:docker-compose.mongodb.yml
CORS_ORIGIN=https://dataq.example.com
CONFIG_PATH=config.yaml

# Use MONGODB_URI, or remove it and configure the component values below.
MONGODB_URI=mongodb://mongodb:27017/dataq-analyzer
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=dataq-analyzer
MONGODB_AUTH_REQUIRED=false
MONGODB_AUTH_SOURCE=admin
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Required only when mqtt.enabled is true in config.yaml.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Generate independent secrets; do not reuse values between installations.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Used once only when no database administrator exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Required only when VideoX playback is enabled in config.yaml.
VIDEOX_API_KEY=